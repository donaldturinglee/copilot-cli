{
  "name": "copilot-cli",
  "version": "0.0.1",
  "description": "Copilot CLI — terminal coding agent",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "copilot": "./src/entrypoints/cli.tsx"
  },
  "scripts": {
    "dev": "bun run src/entrypoints/cli.tsx",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "build": "bun build src/entrypoints/cli.tsx --outdir dist --target bun"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "lodash-es": "^4.17.21",
    "proper-lockfile": "^4.1.2",
    "react": "^19.1.0",
    "semver": "^7.7.1",
    "yaml": "^2.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.1.0",
    "@types/semver": "^7.5.8",
    "typescript": "^5.8.0"
  }
}
